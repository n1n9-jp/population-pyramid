{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Japan population pyramid data",
  "type": "object",
  "required": ["schemaVersion", "fixture", "unit", "ageMax", "yearMin", "yearMax", "xMaxPerSex", "gaps", "basisLabels", "attribution", "sources", "notes", "years"],
  "properties": {
    "schemaVersion": {"const": 1},
    "fixture": {"type": "boolean"},
    "unit": {"const": "person"},
    "ageMax": {"const": 100},
    "yearMin": {"const": 1920},
    "yearMax": {"const": 2025},
    "xMaxPerSex": {"type": "integer", "minimum": 250000, "multipleOf": 250000},
    "gaps": {"type": "array", "items": {"type": "object", "required": ["start", "end", "noteId"],
      "properties": {"start": {"type": "integer"}, "end": {"type": "integer"}, "noteId": {"type": "string"}}}},
    "basisLabels": {"type": "object", "required": ["census", "survey", "intercensal", "estimate"],
      "additionalProperties": {"type": "string"}},
    "attribution": {"type": "string", "minLength": 1},
    "sources": {"type": "object", "additionalProperties": {"type": "object",
      "required": ["title", "table", "url", "unitInSource"],
      "properties": {"title": {"type": "string"}, "table": {"type": "string"}, "url": {"type": "string"},
        "unitInSource": {"enum": ["千人", "人"]}, "sha256": {"type": "string"}, "retrieved": {"type": "string"}}}},
    "notes": {"type": "object", "additionalProperties": {"type": "object",
      "required": ["kind", "short", "text", "appliesTo"],
      "properties": {"kind": {"enum": ["callout", "badge", "footnote", "timeline"]},
        "short": {"type": "string"}, "text": {"type": "string"},
        "appliesTo": {"type": "array", "items": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2}}}}},
    "years": {"type": "array", "minItems": 103, "maxItems": 103, "items": {"$ref": "#/$defs/year"}}
  },
  "$defs": {
    "series": {"type": "array", "minItems": 101, "maxItems": 101,
      "items": {"type": ["integer", "null"], "minimum": 0}},
    "year": {"type": "object",
      "required": ["year", "refDate", "kazoe", "minAge", "openAge", "excludesOkinawa", "basis", "sourceId", "precision", "total", "unknownAge", "noteIds", "male", "female"],
      "additionalProperties": false,
      "properties": {
        "year": {"type": "integer", "minimum": 1920, "maximum": 2025},
        "refDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "kazoe": {"type": "boolean"},
        "minAge": {"enum": [0, 1]},
        "openAge": {"enum": [85, 86, 90, 100]},
        "excludesOkinawa": {"type": "boolean"},
        "basis": {"enum": ["census", "survey", "intercensal", "estimate"]},
        "sourceId": {"type": "string"},
        "precision": {"enum": [1, 1000]},
        "total": {"type": "object", "required": ["male", "female", "both"], "additionalProperties": false,
          "properties": {"male": {"type": "integer"}, "female": {"type": "integer"}, "both": {"type": "integer"}}},
        "unknownAge": {"type": "object", "required": ["male", "female"], "additionalProperties": false,
          "properties": {"male": {"type": "integer", "minimum": 0}, "female": {"type": "integer", "minimum": 0}}},
        "noteIds": {"type": "array", "items": {"type": "string"}},
        "male": {"$ref": "#/$defs/series"},
        "female": {"$ref": "#/$defs/series"}
      }}
  }
}
