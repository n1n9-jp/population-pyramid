{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Japan regional population pyramids (5-year age groups)",
  "type": "object",
  "required": ["schemaVersion", "fixture", "unit", "ageGroups", "years", "xMaxShare", "yearMeta", "areas", "blocks", "series", "attribution", "sources", "notes"],
  "properties": {
    "schemaVersion": {"const": 1},
    "fixture": {"type": "boolean"},
    "unit": {"const": "person"},
    "ageGroups": {"type": "array", "minItems": 18, "maxItems": 18, "items": {"type": "string"}},
    "years": {"type": "array", "minItems": 22, "maxItems": 22, "items": {"type": "integer"}},
    "xMaxShare": {"type": "number", "exclusiveMinimum": 0, "maximum": 0.5},
    "yearMeta": {"type": "object", "minProperties": 22, "maxProperties": 22, "additionalProperties": {
      "type": "object", "required": ["refDate", "kazoe", "basis", "noteIds"], "additionalProperties": false,
      "properties": {"refDate": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, "kazoe": {"type": "boolean"},
        "basis": {"enum": ["国勢調査", "人口調査"]}, "noteIds": {"type": "array", "items": {"type": "string"}}}}},
    "areas": {"type": "array", "minItems": 47, "maxItems": 47, "items": {"type": "object",
      "required": ["code", "name", "short", "block", "tile"], "additionalProperties": false,
      "properties": {"code": {"type": "string", "pattern": "^\\d{2}$"}, "name": {"type": "string"}, "short": {"type": "string"},
        "block": {"enum": ["hokkaido", "tohoku", "kanto", "chubu", "kinki", "chugoku", "shikoku", "kyushu"]},
        "tile": {"$ref": "#/$defs/tile"}}}},
    "blocks": {"type": "array", "minItems": 8, "maxItems": 8, "items": {"type": "object",
      "required": ["id", "name", "prefs", "tile"], "additionalProperties": false,
      "properties": {"id": {"type": "string"}, "name": {"type": "string"},
        "prefs": {"type": "array", "items": {"type": "string", "pattern": "^\\d{2}$"}}, "tile": {"$ref": "#/$defs/tile"}}}},
    "series": {"type": "object", "minProperties": 56, "maxProperties": 56, "additionalProperties": {
      "type": "object", "minProperties": 22, "maxProperties": 22, "additionalProperties": {"$ref": "#/$defs/entry"}}},
    "attribution": {"type": "string", "minLength": 1},
    "sources": {"type": "object", "additionalProperties": {"type": "object", "required": ["title", "table", "url"]}},
    "notes": {"type": "object", "additionalProperties": {"type": "object",
      "required": ["kind", "short", "text", "appliesTo"],
      "properties": {"kind": {"enum": ["badge", "footnote"]}, "short": {"type": "string"}, "text": {"type": "string"},
        "appliesTo": {"type": "array", "items": {"type": "array", "items": {"type": "integer"}, "minItems": 2, "maxItems": 2}}}}}
  },
  "$defs": {
    "tile": {"type": "object", "required": ["x", "y"], "additionalProperties": false,
      "properties": {"x": {"type": "integer", "minimum": 0}, "y": {"type": "integer", "minimum": 0}}},
    "group": {"type": "array", "minItems": 18, "maxItems": 18, "items": {"type": ["integer", "null"], "minimum": 0}},
    "entry": {"type": "object", "required": ["male", "female", "unknown", "total", "openIndex", "missing"], "additionalProperties": false,
      "properties": {"male": {"$ref": "#/$defs/group"}, "female": {"$ref": "#/$defs/group"},
        "unknown": {"type": "object", "required": ["male", "female"], "additionalProperties": false,
          "properties": {"male": {"type": "integer", "minimum": 0}, "female": {"type": "integer", "minimum": 0}}},
        "total": {"type": "integer", "minimum": 0}, "openIndex": {"enum": [14, 16, 17]}, "missing": {"type": "boolean"}}}
  }
}
